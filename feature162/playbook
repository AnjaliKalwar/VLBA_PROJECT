---
# ================================
# NGINX LOAD BALANCER (node1.local)
# ================================
- name: Configure nginx load balancer
  hosts: balancer
  become: yes

  tasks:
    - name: Install nginx
      apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Configure nginx - FIXED PORTS
      copy:
        dest: /etc/nginx/nginx.conf
        content: |
          user www-data;
          worker_processes 1;
          pid /run/nginx.pid;
          include /etc/nginx/modules-enabled/*.conf;

          events {
              worker_connections 768;
          }

          http {
              upstream backend {
                  server node2.local:80 weight=3;     # Apache
                  server node3.local:8080 weight=1;   # Tomcat ✓
              }

              server {
                  listen 80 default_server;
                  listen [::]:80 default_server;

                  location / {
                      proxy_pass http://backend;
                      proxy_set_header Host $host;
                      proxy_set_header X-Real-IP $remote_addr;
                  }
              }

              include /etc/nginx/mime.types;
              default_type application/octet-stream;
          }
      notify: restart nginx

  handlers:
    - name: restart nginx
      service:
        name: nginx
        state: restarted

# ================================
# APACHE (node2.local) - SAME
# ================================
- name: Configure apache web server
  hosts: node2.local
  become: yes
  tasks:
    - name: Install latest apache2
      apt:
        name: apache2
        state: latest
        update_cache: yes

    - name: Ensure apache2 running
      service:
        name: apache2
        state: started
        enabled: yes

    - name: Apache index.html
      copy:
        dest: /var/www/html/index.html
        content: |
          <html><body>jyidngaysqja</body></html>

# ================================
# TOMCAT (node3.local) - FIXED
# ================================
- name: Configure tomcat web server
  hosts: node3.local
  become: yes
  vars:
    tomcat_version: "9.0.35"
    tomcat_base_dir: "/usr/local/apache-tomcat-{{ tomcat_version }}"

  tasks:
    - name: Install Java
      apt:
        name: default-jdk
        state: present
        update_cache: yes

    - name: Download Tomcat
      get_url:
        url: "https://archive.apache.org/dist/tomcat/tomcat-9/v{{ tomcat_version }}/bin/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"

    - name: Extract Tomcat
      unarchive:
        src: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: /usr/local
        remote_src: yes
        creates: "{{ tomcat_base_dir }}"

    - name: ROOT webapp dir
      file:
        path: "{{ tomcat_base_dir }}/webapps/ROOT"
        state: directory
        mode: '0755'

    - name: Tomcat index.html
      copy:
        dest: "{{ tomcat_base_dir }}/webapps/ROOT/index.html"
        content: |
          <html><body>nruznijciesi</body></html>

    - name: Start Tomcat
      command: "{{ tomcat_base_dir }}/bin/startup.sh"
      args:
        chdir: "{{ tomcat_base_dir }}"

    - name: Wait for Tomcat 8080 ✓
      wait_for:
        port: 8080      # ✅ CORRECT PORT
        delay: 5
        timeout: 30
        host: 0.0.0.0   # ✅ localhost on node3
