---
- name: Wait for all nodes to be reachable
  hosts: balancer,web
  gather_facts: no
  tasks:
    - name: Wait until nodes are up
      wait_for_connection:
        delay: 2
        timeout: 60

# ================================
# NGINX LOAD BALANCER (node1.local)
# ================================
- name: Configure nginx load balancer
  hosts: balancer
  become: yes
  gather_facts: yes

  tasks:
    - name: Update apt cache
      apt:
        update_cache: yes
        cache_valid_time: 3600

    - name: Install nginx
      apt:
        name: nginx
        state: present

    - name: Create nginx configuration with correct syntax
      copy:
        dest: /etc/nginx/nginx.conf
        backup: yes
        content: |
          user www-data;
          worker_processes 1;
          pid /run/nginx.pid;
          include /etc/nginx/modules-enabled/*.conf;

          events {
              worker_connections 768;
          }

          http {
              include /etc/nginx/mime.types;
              default_type application/octet-stream;

              sendfile on;
              tcp_nopush on;
              tcp_nodelay on;
              keepalive_timeout 65;

              upstream backend_servers {
                  server node2.local:80 weight=3;
                  server node3.local:8080 weight=1;
              }

              server {
                  listen 80 default_server;
                  listen [::]:80 default_server;
                  server_name _;

                  location / {
                      proxy_pass http://backend_servers;
                      proxy_set_header Host $host;
                      proxy_set_header X-Real-IP $remote_addr;
                      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                      proxy_set_header X-Forwarded-Proto $scheme;
                  }
              }
          }

    - name: Test nginx configuration
      command: nginx -t
      changed_when: false
      register: nginx_test
      failed_when: nginx_test.rc != 0

    - name: Enable and start nginx
      service:
        name: nginx
        state: started
        enabled: yes

# ================================
# APACHE2 WEB SERVER (node2.local)
# ================================
- name: Configure apache2 web server
  hosts: node2.local
  become: yes
  gather_facts: yes

  tasks:
    - name: Update apt cache
      apt:
        update_cache: yes
        cache_valid_time: 3600

    - name: Install latest apache2
      apt:
        name: apache2
        state: latest

    - name: Enable mod_proxy
      apache2_module:
        name: proxy
        state: present
      notify: restart apache2

    - name: Create Apache index.html
      copy:
        dest: /var/www/html/index.html
        content: |
          <!DOCTYPE html>
          <html>
          <head>
              <title>Apache Node</title>
          </head>
          <body>
              <h1>Apache Web Server - Node 2</h1>
              <p>jyidngaysqja</p>
          </body>
          </html>
        owner: www-data
        group: www-data
        mode: '0644'
      notify: restart apache2

    - name: Enable and start apache2
      service:
        name: apache2
        state: started
        enabled: yes

  handlers:
    - name: restart apache2
      service:
        name: apache2
        state: restarted

# ================================
# TOMCAT SERVER (node3.local)
# ================================
- name: Configure tomcat web server
  hosts: node3.local
  become: yes
  gather_facts: yes

  vars:
    tomcat_version: "9.0.35"
    tomcat_dir: "/usr/local/apache-tomcat-{{ tomcat_version }}"
    tomcat_user: tomcat
    tomcat_group: tomcat

  tasks:
    - name: Update apt cache
      apt:
        update_cache: yes
        cache_valid_time: 3600

    - name: Install OpenJDK
      apt:
        name: default-jdk
        state: present

    - name: Create tomcat system user
      user:
        name: "{{ tomcat_user }}"
        shell: /bin/false
        home: /opt/tomcat
        createhome: no
        state: present

    - name: Download Tomcat 9.0.35
      get_url:
        url: "https://archive.apache.org/dist/tomcat/tomcat-9/v{{ tomcat_version }}/bin/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        mode: '0644'
        timeout: 120

    - name: Extract Tomcat to /usr/local
      unarchive:
        src: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: /usr/local
        remote_src: yes
        creates: "{{ tomcat_dir }}"

    - name: Set Tomcat directory permissions
      file:
        path: "{{ tomcat_dir }}"
        owner: "{{ tomcat_user }}"
        group: "{{ tomcat_group }}"
        mode: '0755'
        recurse: yes

    - name: Create Tomcat ROOT webapp directory
      file:
        path: "{{ tomcat_dir }}/webapps/ROOT"
        state: directory
        owner: "{{ tomcat_user }}"
        group: "{{ tomcat_group }}"
        mode: '0755'

    - name: Create Tomcat index.html
      copy:
        dest: "{{ tomcat_dir }}/webapps/ROOT/index.html"
        content: |
          <!DOCTYPE html>
          <html>
          <head>
              <title>Tomcat Node</title>
          </head>
          <body>
              <h1>Tomcat Web Server - Node 3</h1>
              <p>nruznijciesi</p>
          </body>
          </html>
        owner: "{{ tomcat_user }}"
        group: "{{ tomcat_group }}"
        mode: '0644'

    - name: Start Tomcat
      shell: |
        export JAVA_HOME=/usr/lib/jvm/default-java
        {{ tomcat_dir }}/bin/startup.sh
      become_user: "{{ tomcat_user }}"
      environment:
        JAVA_HOME: /usr/lib/jvm/default-java
      register: tomcat_startup
      changed_when: true

    - name: Wait for Tomcat to start on port 8080
      wait_for:
        port: 8080
        delay: 3
        timeout: 30
        host: localhost

    - name: Verify Tomcat is running
      uri:
        url: http://localhost:8080/
        status_code: 200
      register: tomcat_response
      retries: 5
      delay: 2
