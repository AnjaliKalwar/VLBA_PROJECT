---
- name: Configure Nginx Load Balancer
  hosts: node1.local
  become: yes
  tasks:
    - name: Install Nginx [web:3]
      apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Set Nginx worker processes to 1 [web:9]
      lineinfile:
        path: /etc/nginx/nginx.conf
        regexp: '^worker_processes '
        line: 'worker_processes 1;'
      notify: Restart Nginx

    - name: Remove default Nginx site configuration
      file:
        path: /etc/nginx/sites-enabled/default
        state: absent
      notify: Restart Nginx

    - name: Configure Load Balancer and Upstream [web:11]
      copy:
        dest: /etc/nginx/conf.d/load-balancer.conf
        content: |
          upstream backend {
              server node2.local:80 weight=3;
              server node3.local:8080 weight=1;
          }

          server {
              listen 80;
              server_name localhost;

              location / {
                  proxy_pass http://backend;
                  proxy_set_header Host $host;
                  proxy_set_header X-Real-IP $remote_addr;
              }
          }
      notify: Restart Nginx

  handlers:
    - name: Restart Nginx
      service:
        name: nginx
        state: restarted

- name: Configure Apache Web Server
  hosts: node2.local
  become: yes
  tasks:
    - name: Install Apache2 Latest [web:8]
      apt:
        name: apache2
        state: latest
        update_cache: yes

    - name: Set Apache Homepage
      copy:
        content: 'jyidngaysqja'
        dest: /var/www/html/index.html
        mode: '0644'

- name: Configure Tomcat Web Server
  hosts: node3.local
  become: yes
  vars:
    tomcat_version: "9.0.35"
    tomcat_url: "https://archive.apache.org/dist/tomcat/tomcat-9/v9.0.35/bin/apache-tomcat-9.0.35.tar.gz"
    tomcat_home: "/usr/local/tomcat"
  tasks:
    - name: Install Java [web:19]
      apt:
        name: default-jdk
        state: present
        update_cache: yes

    - name: Create Tomcat Group
      group:
        name: tomcat
        state: present

    - name: Create Tomcat User
      user:
        name: tomcat
        group: tomcat
        home: "{{ tomcat_home }}"
        shell: /bin/false
        create_home: no

    - name: Download Tomcat [web:5]
      get_url:
        url: "{{ tomcat_url }}"
        dest: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"

    - name: Extract Tomcat to /usr/local
      unarchive:
        src: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: /usr/local
        remote_src: yes
        creates: "/usr/local/apache-tomcat-{{ tomcat_version }}"

    - name: Create Symlink for Tomcat
      file:
        src: "/usr/local/apache-tomcat-{{ tomcat_version }}"
        dest: "{{ tomcat_home }}"
        state: link

    - name: Set Ownership for Tomcat Directory
      file:
        path: "{{ tomcat_home }}"
        owner: tomcat
        group: tomcat
        recurse: yes

    - name: Set Tomcat Homepage
      copy:
        content: 'nruznijciesi'
        dest: "{{ tomcat_home }}/webapps/ROOT/index.html"
        owner: tomcat
        group: tomcat
        mode: '0644'

    - name: Create Systemd Service for Tomcat
      copy:
        dest: /etc/systemd/system/tomcat.service
        content: |
          [Unit]
          Description=Apache Tomcat Web Application Container
          After=network.target

          [Service]
          Type=forking
          User=tomcat
          Group=tomcat
          Environment="JAVA_HOME=/usr/lib/jvm/default-java"
          Environment="CATALINA_PID={{ tomcat_home }}/temp/tomcat.pid"
          Environment="CATALINA_HOME={{ tomcat_home }}"
          Environment="CATALINA_BASE={{ tomcat_home }}"
          ExecStart={{ tomcat_home }}/bin/startup.sh
          ExecStop={{ tomcat_home }}/bin/shutdown.sh

          [Install]
          WantedBy=multi-user.target
      notify:
        - Reload Systemd
        - Restart Tomcat

  handlers:
    - name: Reload Systemd
      systemd:
        daemon_reload: yes

    - name: Restart Tomcat
      service:
        name: tomcat
        state: restarted
        enabled: yes
