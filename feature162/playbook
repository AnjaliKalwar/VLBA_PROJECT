---
######################################################################
# 1) NGINX LOAD BALANCER ON node1.local
######################################################################
- name: Configure Nginx Load Balancer
  hosts: node1.local
  become: yes

  tasks:
    - name: Install Nginx
      apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Set Nginx worker processes to 1
      lineinfile:
        path: /etc/nginx/nginx.conf
        regexp: '^worker_processes'
        line: 'worker_processes 1;'
      notify: Restart Nginx

    - name: Remove default Nginx site
      file:
        path: /etc/nginx/sites-enabled/default
        state: absent
      notify: Restart Nginx

    - name: Configure weighted load balancer
      copy:
        dest: /etc/nginx/conf.d/load-balancer.conf
        content: |
          upstream backend {
              server node2.local:80 weight=3;
              server node3.local:8080 weight=1;
          }

          server {
              listen 80;

              location / {
                  proxy_pass http://backend;
                  proxy_set_header Host $host;
                  proxy_set_header X-Real-IP $remote_addr;
              }
          }
      notify: Restart Nginx

  handlers:
    - name: Restart Nginx
      service:
        name: nginx
        state: restarted


######################################################################
# 2) APACHE ON node2.local
######################################################################
- name: Configure Apache Web Server
  hosts: node2.local
  become: yes

  tasks:
    - name: Install Apache
      apt:
        name: apache2
        state: latest
        update_cache: yes

    - name: Set Apache Homepage
      copy:
        content: "jyidngaysqja"
        dest: /var/www/html/index.html
        mode: '0644'

    - name: Start Apache
      service:
        name: apache2
        state: started
        enabled: yes


######################################################################
# 3) TOMCAT ON node3.local (NO SYSTEMD, ONLY startup.sh)
######################################################################
- name: Configure Tomcat Web Server
  hosts: node3.local
  become: yes

  vars:
    tomcat_version: "9.0.35"
    tomcat_url: "https://archive.apache.org/dist/tomcat/tomcat-9/v9.0.35/bin/apache-tomcat-9.0.35.tar.gz"
    tomcat_home: "/usr/local/tomcat"

  tasks:
    - name: Install Java
      apt:
        name: default-jdk
        state: present
        update_cache: yes

    - name: Create tomcat group
      group:
        name: tomcat
        state: present

    - name: Create tomcat user
      user:
        name: tomcat
        group: tomcat
        home: "{{ tomcat_home }}"
        shell: /bin/false
        create_home: no

    - name: Download Tomcat
      get_url:
        url: "{{ tomcat_url }}"
        dest: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"

    - name: Extract Tomcat
      unarchive:
        src: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: /usr/local
        remote_src: yes
        creates: "/usr/local/apache-tomcat-{{ tomcat_version }}"

    - name: Create tomcat symlink
      file:
        src: "/usr/local/apache-tomcat-{{ tomcat_version }}"
        dest: "{{ tomcat_home }}"
        state: link

    - name: Fix permissions
      file:
        path: "{{ tomcat_home }}"
        owner: tomcat
        group: tomcat
        recurse: yes

    - name: Set Tomcat Homepage
      copy:
        content: "nruznijciesi"
        dest: "{{ tomcat_home }}/webapps/ROOT/index.html"
        owner: tomcat
        group: tomcat
        mode: '0644'

    - name: Make startup executable
      file:
        path: "{{ tomcat_home }}/bin/startup.sh"
        mode: '0755'

    ###########################################################
   
    #   This works inside Drone containers.
    ###########################################################
    - name: Start Tomcat (nohup, idempotent)
      shell: |
        if ! pgrep -f "org.apache.catalina.startup.Bootstrap" > /dev/null; then
          nohup {{ tomcat_home }}/bin/startup.sh >/tmp/tomcat.out 2>&1 &
        fi

    - name: Wait for Tomcat port
      wait_for:
        port: 8080
        delay: 2
        timeout: 40
