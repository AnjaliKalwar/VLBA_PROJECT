---
# Nginx load balancer on node1.local (group: balancer)
- name: Configure nginx load balancer
  hosts: balancer
  become: yes

  tasks:
    - name: Install nginx
      apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Configure nginx worker processes to 1 and upstream
      copy:
        dest: /etc/nginx/nginx.conf
        content: |
          user www-data;
          worker_processes 1;
          pid /run/nginx.pid;
          include /etc/nginx/modules-enabled/*.conf;

          events {
              worker_connections 768;
          }

          http {
              upstream backend {
                  server node2.local weight=3;
                  server node3.local weight=1;
              }

              server {
                  listen 80 default_server;
                  listen [::]:80 default_server;

                  location / {
                      proxy_pass http://backend;
                  }
              }

              include /etc/nginx/mime.types;
              default_type application/octet-stream;
              sendfile on;
              keepalive_timeout 65;
          }
      notify: restart nginx

  handlers:
    - name: restart nginx
      service:
        name: nginx
        state: restarted

# Apache web server on node2.local
- name: Configure apache web server
  hosts: node2.local
  become: yes

  tasks:
    - name: Install latest apache2
      apt:
        name: apache2
        state: latest
        update_cache: yes

    - name: Ensure apache2 is enabled and started
      service:
        name: apache2
        state: started
        enabled: yes

    - name: Create Apache index page with required content
      copy:
        dest: /var/www/html/index.html
        content: |
          <html>
          <head><title>Apache node</title></head>
          <body>
          jyidngaysqja
          </body>
          </html>
        owner: www-data
        group: www-data
        mode: '0644'

# Tomcat 9.0.35 on node3.local
- name: Configure tomcat web server
  hosts: node3.local
  become: yes

  vars:
    tomcat_version: "9.0.35"
    tomcat_install_dir: "/usr/local"
    tomcat_base_dir: "/usr/local/apache-tomcat-9.0.35"

  tasks:
    - name: Install Java (OpenJDK)
      apt:
        name: default-jdk
        state: present
        update_cache: yes

    - name: Download Tomcat archive
      get_url:
        url: "https://archive.apache.org/dist/tomcat/tomcat-9/v{{ tomcat_version }}/bin/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        mode: '0644'

    - name: Extract Tomcat under /usr/local
      unarchive:
        src: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: "{{ tomcat_install_dir }}"
        remote_src: yes
        creates: "{{ tomcat_base_dir }}"

    - name: Create simple ROOT index page with required content
      copy:
        dest: "{{ tomcat_base_dir }}/webapps/ROOT/index.html"
        content: |
          <html>
          <head><title>Tomcat node</title></head>
          <body>
          nruznijciesi
          </body>
          </html>
        owner: root
        group: root
        mode: '0644'

    - name: Start Tomcat in background via startup script
      command: "{{ tomcat_base_dir }}/bin/startup.sh"
      args:
        chdir: "{{ tomcat_base_dir }}"
      register: tomcat_start
      changed_when: "'Tomcat started' in tomcat_start.stdout or tomcat_start.rc == 0"
