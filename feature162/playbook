---
- name: Setup load balancer and web servers
  hosts: all
  gather_facts: yes
  become: yes

  tasks:
    - name: Debug start of playbook
      debug:
        msg: "Playbook started on {{ inventory_hostname }}"

    - name: Ensure Nginx log directory exists (CI safe)
      file:
        path: /var/log/nginx
        state: directory
        owner: www-data
        group: adm
        mode: 0755
      when: inventory_hostname == "node1.local"
      register: nginx_log_dir
    - name: Debug Nginx log directory
      debug:
        var: nginx_log_dir
      when: inventory_hostname == "node1.local"

    - name: Install Nginx on balancer node
      apt:
        name: nginx
        state: present
        update_cache: yes
      when: inventory_hostname == "node1.local"
      notify:
        - restart nginx
      register: nginx_install
    - name: Debug Nginx installation
      debug:
        var: nginx_install
      when: inventory_hostname == "node1.local"

    - name: Configure Nginx load balancer
      template:
        src: nginx_lb.conf.j2
        dest: /etc/nginx/nginx.conf
      when: inventory_hostname == "node1.local"
      notify:
        - restart nginx
      register: nginx_config
    - name: Debug Nginx config task
      debug:
        var: nginx_config
      when: inventory_hostname == "node1.local"

    - name: Install Apache2 on web node 1
      apt:
        name: apache2
        state: latest
        update_cache: yes
      when: inventory_hostname == "node2.local"
      notify:
        - restart apache2
      register: apache_install
    - name: Debug Apache installation
      debug:
        var: apache_install
      when: inventory_hostname == "node2.local"

    - name: Create Apache homepage
      copy:
        dest: /var/www/html/index.html
        content: "jyidngaysqja"
      when: inventory_hostname == "node2.local"
      register: apache_homepage
    - name: Debug Apache homepage creation
      debug:
        var: apache_homepage
      when: inventory_hostname == "node2.local"

    - name: Install Tomcat 9.0.35 on web node 2
      get_url:
        url: https://downloads.apache.org/tomcat/tomcat-9/v9.0.35/bin/apache-tomcat-9.0.35.tar.gz
        dest: /tmp/apache-tomcat-9.0.35.tar.gz
      when: inventory_hostname == "node3.local"
      register: tomcat_download
    - name: Debug Tomcat download
      debug:
        var: tomcat_download
      when: inventory_hostname == "node3.local"

    - name: Extract Tomcat
      unarchive:
        src: /tmp/apache-tomcat-9.0.35.tar.gz
        dest: /usr/local/
        remote_src: yes
      when: inventory_hostname == "node3.local"
      register: tomcat_extract
    - name: Debug Tomcat extraction
      debug:
        var: tomcat_extract
      when: inventory_hostname == "node3.local"

    - name: Create Tomcat homepage
      copy:
        dest: /usr/local/apache-tomcat-9.0.35/webapps/ROOT/index.html
        content: "nruznijciesi"
      when: inventory_hostname == "node3.local"
      register: tomcat_homepage
    - name: Debug Tomcat homepage creation
      debug:
        var: tomcat_homepage
      when: inventory_hostname == "node3.local"

    - name: Debug end of playbook
      debug:
        msg: "Playbook finished tasks on {{ inventory_hostname }}"

  handlers:
    - name: restart nginx
      service:
        name: nginx
        state: restarted

    - name: restart apache2
      service:
        name: apache2
        state: restarted
