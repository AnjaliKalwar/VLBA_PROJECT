---
# ================================
# NGINX LOAD BALANCER (node1.local)
# ================================
- name: Configure nginx load balancer
  hosts: balancer
  become: yes

  tasks:
    - name: DEBUG — Starting balancer config
      debug:
        msg: "Installing and configuring NGINX on balancer…"

    - name: Install nginx
      apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Configure nginx with 1 worker and weighted upstream
      copy:
        dest: /etc/nginx/nginx.conf
        content: |
          user www-data;
          worker_processes 1;
          pid /run/nginx.pid;
          include /etc/nginx/modules-enabled/*.conf;

          events {
              worker_connections 768;
          }

          http {
              upstream backend {
                  server node2.local:80 weight=3;
                  server node3.local:80 weight=1;
              }

              server {
                  listen 80 default_server;
                  listen [::]:80 default_server;

                  location / {
                      proxy_pass http://backend;
                      proxy_set_header Host $host;
                      proxy_set_header X-Real-IP $remote_addr;
                  }
              }

              include /etc/nginx/mime.types;
              default_type application/octet-stream;
              sendfile on;
              keepalive_timeout 65;
          }
      notify: restart nginx

  handlers:
    - name: restart nginx
      service:
        name: nginx
        state: restarted


# ================================
# APACHE WEB SERVER (node2.local)
# ================================
- name: Configure apache web server
  hosts: node2.local
  become: yes

  tasks:
    - name: DEBUG — Starting Apache setup
      debug:
        msg: "Installing Apache on node2…"

    - name: Install latest apache2
      apt:
        name: apache2
        state: latest
        update_cache: yes

    - name: Ensure apache2 is enabled and started
      service:
        name: apache2
        state: started
        enabled: yes

    - name: Create Apache index page
      copy:
        dest: /var/www/html/index.html
        content: |
          <html>
          <head><title>Apache node</title></head>
          <body>
          jyidngaysqja
          </body>
          </html>
        owner: www-data
        group: www-data
        mode: '0644'


# ================================
# TOMCAT SERVER (node3.local)
# ================================
- name: Configure tomcat web server
  hosts: node3.local
  become: yes

  vars:
    tomcat_version: "9.0.35"
    tomcat_base_dir: "/usr/local/apache-tomcat-{{ tomcat_version }}"

  tasks:
    - name: DEBUG — Starting Tomcat installation
      debug:
        msg: "Installing Tomcat on node3…"

    - name: Install Java (OpenJDK)
      apt:
        name: default-jdk
        state: present
        update_cache: yes

    - name: Download Tomcat archive
      get_url:
        url: "https://archive.apache.org/dist/tomcat/tomcat-9/v{{ tomcat_version }}/bin/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        mode: '0644'

    - name: Extract Tomcat under /usr/local
      unarchive:
        src: "/tmp/apache-tomcat-{{ tomcat_version }}.tar.gz"
        dest: /usr/local
        remote_src: yes
        creates: "{{ tomcat_base_dir }}"

    - name: Ensure ROOT webapp directory exists
      file:
        path: "{{ tomcat_base_dir }}/webapps/ROOT"
        state: directory
        mode: '0755'

    - name: Create Tomcat index page
      copy:
        dest: "{{ tomcat_base_dir }}/webapps/ROOT/index.html"
        content: |
          <html>
          <head><title>Tomcat node</title></head>
          <body>
          nruznijciesi
          </body>
          </html>
        mode: '0644'

    - name: Start Tomcat
      command: "{{ tomcat_base_dir }}/bin/startup.sh"
      args:
        chdir: "{{ tomcat_base_dir }}"
      register: tomcat_start
      changed_when: tomcat_start.rc == 0

    # ========== IMPORTANT FIX ==========
    # CI FAIL FIX → WAIT UNTIL TOMCAT REALLY LISTENS ON PORT 80
    - name: DEBUG — Waiting for Tomcat to come up…
      debug:
        msg: "Waiting for Tomcat to respond on port 80…"

    - name: Wait for Tomcat to be UP on port 80
      wait_for:
        port: 80
        delay: 2
        timeout: 20

    - name: DEBUG — Tomcat is UP
      debug:
        msg: "Tomcat is confirmed UP on port 80!"
