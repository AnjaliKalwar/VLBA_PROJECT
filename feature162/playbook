---
- name: Setup load balancer and web servers
  hosts: all
  become: yes

  vars:
    max_retries: 10
    retry_delay: 5
    nginx_log_path: /var/log/nginx/access.log
    tomcat_log_path: /var/log/tomcat9/catalina.out
    apache_log_path: /var/log/apache2/access.log

  tasks:

    - name: Update apt cache
      apt:
        update_cache: yes
      when: ansible_os_family == "Debian"

    - name: Install required packages
      apt:
        name:
          - nginx
          - tomcat9
          - apache2
        state: present
      when: ansible_os_family == "Debian"

    - name: Ensure SSH is running
      service:
        name: ssh
        state: started
        enabled: yes
      register: ssh_service
      retries: "{{ max_retries }}"
      delay: "{{ retry_delay }}"
      until: ssh_service.state == "started"

    - name: Ensure Nginx is running
      service:
        name: nginx
        state: started
        enabled: yes
      register: nginx_service
      retries: "{{ max_retries }}"
      delay: "{{ retry_delay }}"
      until: nginx_service.state == "started"

    - name: Ensure Tomcat is running
      service:
        name: tomcat9
        state: started
        enabled: yes
      register: tomcat_service
      retries: "{{ max_retries }}"
      delay: "{{ retry_delay }}"
      until: tomcat_service.state == "started"

    - name: Ensure Apache is running
      service:
        name: apache2
        state: started
        enabled: yes
      register: apache_service
      retries: "{{ max_retries }}"
      delay: "{{ retry_delay }}"
      until: apache_service.state == "started"

    - name: Wait for Nginx log to appear
      stat:
        path: "{{ nginx_log_path }}"
      register: nginx_log
      retries: "{{ max_retries }}"
      delay: "{{ retry_delay }}"
      until: nginx_log.stat.exists

    - name: Wait for Tomcat log to appear
      stat:
        path: "{{ tomcat_log_path }}"
      register: tomcat_log
      retries: "{{ max_retries }}"
      delay: "{{ retry_delay }}"
      until: tomcat_log.stat.exists

    - name: Wait for Apache log to appear
      stat:
        path: "{{ apache_log_path }}"
      register: apache_log
      retries: "{{ max_retries }}"
      delay: "{{ retry_delay }}"
      until: apache_log.stat.exists

    - name: Debug - confirm all services started
      debug:
        msg: |
          SSH: {{ ssh_service.state }}
          Nginx: {{ nginx_service.state }}
          Tomcat: {{ tomcat_service.state }}
          Apache: {{ apache_service.state }}
          Nginx log exists: {{ nginx_log.stat.exists }}
          Tomcat log exists: {{ tomcat_log.stat.exists }}
          Apache log exists: {{ apache_log.stat.exists }}

    # Additional configuration tasks
    - name: Deploy Nginx configuration
      copy:
        src: files/nginx.conf
        dest: /etc/nginx/nginx.conf
      notify: Reload Nginx

    - name: Deploy Tomcat configuration
      copy:
        src: files/server.xml
        dest: /etc/tomcat9/server.xml
      notify: Restart Tomcat

    - name: Deploy Apache configuration
      copy:
        src: files/apache2.conf
        dest: /etc/apache2/apache2.conf
      notify: Restart Apache

  handlers:
    - name: Reload Nginx
      service:
        name: nginx
        state: reloaded

    - name: Restart Tomcat
      service:
        name: tomcat9
        state: restarted

    - name: Restart Apache
      service:
        name: apache2
        state: restarted
